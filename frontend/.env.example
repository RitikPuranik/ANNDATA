# --- API ---------------------------------------------------------------
# Base URL of the backend API (used by ContactSupportForm and other
# client-side fetch calls). Leave blank to use same-origin/relative paths
# if the frontend is proxied to the backend.
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"

# --- Sign in with Google ------------------------------------------------
# OAuth client ID from Google Cloud Console (Web application type). Must
# match the backend's GOOGLE_CLIENT_ID — this value is not secret, it's
# embedded in the page and checked server-side on every login.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
