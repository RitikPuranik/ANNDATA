# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/anndata?schema=public"

# --- Auth secrets (generate strong random values, never commit real ones) ---
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
SESSION_SECRET="replace-with-another-long-random-secret"

JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS="30"

# --- App ----------------------------------------------------------------
NODE_ENV="development"
PORT="4000"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:4000"

# Sign in with Google — OAuth client ID from Google Cloud Console
# (Web application type). Same value the frontend uses as
# NEXT_PUBLIC_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=""

# --- Password recovery OTP via Twilio Verify -------------------------------
# Twilio Verify manages OTP generation, delivery, expiry and verification.
# Create one Verify Service in Twilio Console and put its VA... SID below.
TWILIO_ENABLED="false"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_VERIFY_SERVICE_SID=""
TWILIO_VERIFY_BASE_URL="https://verify.twilio.com/v2"
TWILIO_TIMEOUT_MS="10000"

# --- Redis (rate limiting / session helpers) --------------------------------
REDIS_URL="redis://localhost:6379"

# --- Analytics / monitoring (leave blank to disable) ------------------------
POSTHOG_API_KEY=""
POSTHOG_HOST="https://app.posthog.com"

SENTRY_DSN=""

# --- Cookies ------------------------------------------------------------
COOKIE_DOMAIN=""\n# Leave blank for separate frontend/API hosts such as Vercel + Render.\n# Only set this when both apps intentionally share a parent cookie domain.

# --- Market data (Module 6) -------------------------------------------------
# Enable only after the government API credentials and resource ID are configured.
MARKET_SYNC_ENABLED="false"
MARKET_DATA_GOV_API_KEY=""
MARKET_DATA_GOV_RESOURCE_ID=""
MARKET_DATA_GOV_BASE_URL="https://api.data.gov.in/resource"
MARKET_DATA_GOV_TIMEOUT_MS="15000"
MARKET_DATA_GOV_PAGE_SIZE="500"
MARKET_DATA_GOV_MAX_RETRIES="3"
MARKET_DATA_GOV_RATE_LIMIT_MS="250"

# --- Warehouse ingestion (Module 9 ecosystem layer) --------------------------
# Both left disabled/blank: no real government or private-partner warehouse
# API is configured. Enabling either without a real provider implementation
# has no effect — see UnavailableGovernmentWarehouseProvider /
# UnavailablePartnerWarehouseProvider.
WAREHOUSE_GOVERNMENT_PROVIDER_ENABLED="false"
# FCI/IISFM public government warehouse API
FCI_IISFM_API_BASE_URL="https://api.iisfm.nic.in"
FCI_IISFM_DEPOTS_ENDPOINT="/DepotsWithCap"
WAREHOUSE_GOVERNMENT_PROVIDER_TIMEOUT_MS="15000"
WAREHOUSE_GOVERNMENT_PROVIDER_MAX_RETRIES="3"
WAREHOUSE_PARTNER_PROVIDER_ENABLED="false"
WAREHOUSE_PARTNER_PROVIDER_TIMEOUT_MS="15000"
WAREHOUSE_PARTNER_PROVIDER_MAX_RETRIES="3"
WAREHOUSE_SYNC_BATCH_SIZE="100"

# --- WhatsApp Farmer Assistant (Meta WhatsApp Business Cloud API) -------------
# Disabled by default. With WHATSAPP_ENABLED="false" none of the values below
# are required, the webhook answers 503, and no WhatsApp/AI network call is
# ever made. See docs/modules/module-whatsapp-farmer-assistant.md.
WHATSAPP_ENABLED="false"
WHATSAPP_PROVIDER="meta"
WHATSAPP_API_BASE_URL="https://graph.facebook.com"
WHATSAPP_API_VERSION="v21.0"
# Permanent System User access token (Meta Business Settings) — a secret.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Any random string you choose; must match the "Verify token" in the Meta dashboard.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# Meta *App Secret* (App settings → Basic). Used to verify X-Hub-Signature-256.
WHATSAPP_APP_SECRET=""
WHATSAPP_TIMEOUT_MS="10000"
WHATSAPP_MAX_RETRIES="3"
# Idle time before a half-finished conversation is reset.
WHATSAPP_CONVERSATION_TTL_MINUTES="30"
# Webhook events older than this are acknowledged but not answered.
WHATSAPP_MAX_MESSAGE_AGE_SECONDS="21600"
WHATSAPP_RATE_LIMIT_PER_MINUTE="20"
WHATSAPP_AI_RATE_LIMIT_PER_HOUR="30"
WHATSAPP_MATCHING_RATE_LIMIT_PER_HOUR="20"
# Optional natural-language layer ("none" = deterministic rules only).
WHATSAPP_AI_PROVIDER="none"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
WHATSAPP_AI_TIMEOUT_MS="6000"
# DEV/DEMO ONLY — auto-link a WhatsApp number that equals a farmer's registered
# mobile. Ignored when NODE_ENV=production.
WHATSAPP_DEV_AUTO_LINK_BY_MOBILE="false"
# Transactional email (welcome, password reset, receipts). Disabled by
# default — with EMAIL_ENABLED=false no provider credentials are required
# and every email is only logged in development, never sent.
EMAIL_ENABLED="false"
EMAIL_PROVIDER="emailjs"
EMAIL_FROM_ADDRESS="notifications@anndata.app"
EMAIL_FROM_NAME="Anndata"
EMAIL_TIMEOUT_MS="10000"
EMAIL_MAX_RETRIES="2"
# Inbox that receives "Contact support" widget submissions (see
# notifications/contactSupport.routes.ts). Falls back to
# EMAIL_FROM_ADDRESS above if left blank.
CONTACT_SUPPORT_TO_EMAIL=""

# --- EmailJS (https://www.emailjs.com) — used when EMAIL_PROVIDER="emailjs" -
# 1. Create a free account, add an Email Service (e.g. Gmail/Outlook/SMTP) —
#    that gives you EMAILJS_SERVICE_ID.
# 2. Create ONE template with subject "{{subject}}" and body "{{{html_content}}}"
#    (TRIPLE braces — this renders the already-built HTML from
#    email.templates.ts unescaped instead of as visible tags). That gives you
#    EMAILJS_TEMPLATE_ID.
# 3. Account → General gives you the Public Key. If "Strict Mode" is on,
#    Account → API Keys gives you the Private Key too (required server-side).
EMAILJS_API_BASE_URL="https://api.emailjs.com"
EMAILJS_SERVICE_ID=""
EMAILJS_TEMPLATE_ID=""
EMAILJS_PUBLIC_KEY=""
EMAILJS_PRIVATE_KEY=""

