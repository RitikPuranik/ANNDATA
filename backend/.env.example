# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/anndata?schema=public"

# --- Auth secrets (generate strong random values, never commit real ones) ---
JWT_ACCESS_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-different-long-random-secret"
SESSION_SECRET="replace-with-another-long-random-secret"

JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN_DAYS="30"

# --- App ----------------------------------------------------------------
NODE_ENV="development"
PORT="4000"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:4000"

# --- Redis (rate limiting / session helpers) --------------------------------
REDIS_URL="redis://localhost:6379"

# --- Analytics / monitoring (leave blank to disable) ------------------------
POSTHOG_API_KEY=""
POSTHOG_HOST="https://app.posthog.com"

SENTRY_DSN=""

# --- Cookies ------------------------------------------------------------
COOKIE_DOMAIN="localhost"

# --- Market data (Module 6) -------------------------------------------------
# Enable only after the government API credentials and resource ID are configured.
MARKET_SYNC_ENABLED="false"
MARKET_DATA_GOV_API_KEY=""
MARKET_DATA_GOV_RESOURCE_ID=""
MARKET_DATA_GOV_BASE_URL="https://api.data.gov.in/resource"
MARKET_DATA_GOV_TIMEOUT_MS="15000"
MARKET_DATA_GOV_PAGE_SIZE="500"
MARKET_DATA_GOV_MAX_RETRIES="3"
MARKET_DATA_GOV_RATE_LIMIT_MS="250"

# --- Warehouse ingestion (Module 9 ecosystem layer) --------------------------
# Both left disabled/blank: no real government or private-partner warehouse
# API is configured. Enabling either without a real provider implementation
# has no effect — see UnavailableGovernmentWarehouseProvider /
# UnavailablePartnerWarehouseProvider.
WAREHOUSE_GOVERNMENT_PROVIDER_ENABLED="false"
# FCI/IISFM public government warehouse API
FCI_IISFM_API_BASE_URL="https://api.iisfm.nic.in"
FCI_IISFM_DEPOTS_ENDPOINT="/DepotsWithCap"
WAREHOUSE_GOVERNMENT_PROVIDER_TIMEOUT_MS="15000"
WAREHOUSE_GOVERNMENT_PROVIDER_MAX_RETRIES="3"
WAREHOUSE_PARTNER_PROVIDER_ENABLED="false"
WAREHOUSE_PARTNER_PROVIDER_TIMEOUT_MS="15000"
WAREHOUSE_PARTNER_PROVIDER_MAX_RETRIES="3"
WAREHOUSE_SYNC_BATCH_SIZE="100"

# --- WhatsApp Farmer Assistant (Meta WhatsApp Business Cloud API) -------------
# Disabled by default. With WHATSAPP_ENABLED="false" none of the values below
# are required, the webhook answers 503, and no WhatsApp/AI network call is
# ever made. See docs/modules/module-whatsapp-farmer-assistant.md.
WHATSAPP_ENABLED="false"
WHATSAPP_PROVIDER="meta"
WHATSAPP_API_BASE_URL="https://graph.facebook.com"
WHATSAPP_API_VERSION="v21.0"
# Permanent System User access token (Meta Business Settings) — a secret.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
# Any random string you choose; must match the "Verify token" in the Meta dashboard.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# Meta *App Secret* (App settings → Basic). Used to verify X-Hub-Signature-256.
WHATSAPP_APP_SECRET=""
WHATSAPP_TIMEOUT_MS="10000"
WHATSAPP_MAX_RETRIES="3"
# Idle time before a half-finished conversation is reset.
WHATSAPP_CONVERSATION_TTL_MINUTES="30"
# Webhook events older than this are acknowledged but not answered.
WHATSAPP_MAX_MESSAGE_AGE_SECONDS="21600"
WHATSAPP_RATE_LIMIT_PER_MINUTE="20"
WHATSAPP_AI_RATE_LIMIT_PER_HOUR="30"
WHATSAPP_MATCHING_RATE_LIMIT_PER_HOUR="20"
# Optional natural-language layer ("none" = deterministic rules only).
WHATSAPP_AI_PROVIDER="none"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.0-flash"
WHATSAPP_AI_TIMEOUT_MS="6000"
# DEV/DEMO ONLY — auto-link a WhatsApp number that equals a farmer's registered
# mobile. Ignored when NODE_ENV=production.
WHATSAPP_DEV_AUTO_LINK_BY_MOBILE="false"